{
  "id": "aref_eta",
  "title": "ETA Bar",
  "description": "Puts Apple Maps' arrival time in the cluster's bottom strip, between the clock and the drive mode. Shows the arrival time, time and distance left that CarPlay reports, and logs what the car's guidance services send to eta-probe.log. Test A and Test B tell the car's guidance that a route is active with no CarPlay provider (none / other), to see whether the strip then shows the ETA; Test: reset sets back what the car had.",
  "version": "0.4.1",
  "vendor": "aref",
  "loggingId": "OAR7",
  "startWidget": {
    "comment": "Home-screen widget (kit/runtime/homewidget.js): the big size is a 384 x 256 picture main.js draws, the small size two text lines.",
    "name": "ETA",
    "layout": "LT_Table_OnlineApps_DriveRecorderWidget",
    "image": "BackgroundImage1",
    "size": [
      384,
      256
    ],
    "safe": [
      0.09,
      0.1
    ],
    "cells": {
      "ErrorInfo": [
        false,
        "Bool"
      ],
      "background": [
        true,
        "Bool"
      ],
      "Title": [
        "",
        "Text"
      ],
      "ProgressbarVisible": [
        false,
        "Bool"
      ],
      "Progress": [
        0,
        "Float"
      ],
      "TextRecordings": [
        "",
        "Text"
      ],
      "TextCam": [
        "",
        "Text"
      ],
      "TimeElapsed": [
        "",
        "Text"
      ],
      "TimeRemaining": [
        "",
        "Text"
      ]
    }
  },
  "signals": {
    "de.bmw.infotainment.navigation.projectedmodeguiding.ProjectedModeGuiding": {
      "_instances": "Main_Instance",
      "waypoints": "rs",
      "currentRoad": "rs",
      "activeRouteChange": "rs",
      "_methods": [
        "setGuidanceState"
      ]
    },
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "_instances": "Main_Instance",
      "finalDestinationInfo": "rs",
      "nextDestinationInfo": "rs",
      "allDestinationsInfo": "rs",
      "guidanceState": "rs",
      "guidingProvider": "rs",
      "currentRoad": "rs",
      "travelledDistance": "rs",
      "travelledTime": "rs"
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
      "_instances": "CarPlayManagerInst1",
      "projectedGuidanceActive": "rs",
      "projectedGuidanceMetadataAvailable": "rs"
    }
  },
  "screens": [
