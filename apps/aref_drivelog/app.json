      "title": "Drive Log",
      "buttons": [
        ["BTN_VIEW", "History"],
        ["BTN_EXPORT", "Save CSV"],
        ["BTN_MORE", "More"]
      ]
    }
  ],
  "settings": [
    {"key": "theme", "label": "Colours", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "units", "label": "Units", "type": "choice", "default": "us", "options": [["us", "mph, F"], ["metric", "km/h, C"]]}
  ]
